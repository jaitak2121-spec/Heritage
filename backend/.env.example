# Database Configuration
# Local SQLite development default:
DATABASE_URL=sqlite:///./heritagelens.db

# Supabase PostgreSQL Session Pooler (For Render deployment):
# Use the Supabase Session Pooler connection URI (IPv4-compatible for cloud providers like Render).
# 'postgres://', 'postgresql://', and 'postgresql+psycopg://' are normalized to use psycopg2.
# Percent-encode special characters in the password (for example, @ as %40 and / as %2F):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Server & Network Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://heritage-pearl.vercel.app
HOST=0.0.0.0
PORT=8000

# Curator writes (generate a long random token secret; never expose either value to Vite)
CURATOR_PASSWORD=
CURATOR_TOKEN_SECRET=
CURATOR_TOKEN_TTL_SECONDS=28800
CURATOR_LOGIN_MAX_ATTEMPTS=5
CURATOR_LOGIN_WINDOW_SECONDS=300

# Original document storage. Local is suitable for development only.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
DOCUMENT_PROCESSING_MODE=inline
DOCUMENT_PROCESSING_WORKERS=1

# Render production storage (create this bucket as PRIVATE in Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=heritage-documents

# Omnirouter AI Configuration (Leave blank for grounded local archive mode)
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=https://api.omnirouter.com/v1
OMNIROUTER_MODEL=google/gemini-2.0-flash
